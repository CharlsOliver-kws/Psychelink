# ============================================================
# PsycheLink 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，切勿提交到版本库
# ============================================================

# --- 大模型（必填）---
# 智谱开放平台 API Key（https://open.bigmodel.cn）
ZHIPU_API_KEY=

# --- 大模型（可选，默认智谱 GLM）---
# OpenAI 兼容 API 地址
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名
# LLM_MODEL=glm-4.5-air

# --- 风险预警邮件（触发 RISK 意图时发送）---
# 发件邮箱（QQ 邮箱需开通 SMTP 并生成授权码，非登录密码）
MAIL_USERNAME=
# SMTP 授权码
MAIL_PASSWORD=
# 预警接收邮箱（如辅导员/管理员）
ALERT_RECIPIENT=

# --- ChromaDB（可选，默认 localhost:8000）---
# CHROMA_URL=http://localhost:8000

# --- OpenTelemetry（可选，仅 scripts/run-with-otel 启动方式需要）---
# OTLP 上报地址
# OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:8001/api/ingest/otlp
# Langfuse 云密钥（直报 Langfuse 时填写）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com
